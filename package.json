{
  "name": "@1inch/cross-chain-swap",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:1inch/cross-chain-swap.git"
  },
  "license": "MIT",
  "dependencies": {
    "@1inch/limit-order-protocol-contract": "^4.3.3",
    "@1inch/limit-order-settlement": "^3.1.0",
    "@1inch/solidity-utils": "^6.9.10",
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@ignored/imports-plugin": "^0.0.1",
    "@types/node": "^26.1.0",
    "eslint": "8.56.0",
    "forge-std": "foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.9.0",
    "murky": "dmfxyz/murky#991e371eb1dfa9f86701869eb08ec4e98c3cc0b0",
    "rimraf": "5.0.5",
    "solc": "0.8.23",
    "solhint": "5.0.1",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@1inch/solidity-utils": "6.9.10",
    "@openzeppelin/contracts": "5.6.1"
  },
  "scripts": {
    "clean": "hardhat clean && rimraf coverage",
    "build": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "coverage": "hardhat test solidity --coverage",
    "coverage:zksync": "mkdir -p coverage && FOUNDRY_PROFILE=zksync forge coverage --zksync --report lcov --ir-minimum --report-file coverage/lcov.info",
    "coverage:html": "bash scripts/coverage.sh",
    "deploy": "./scripts/deploy.sh",
    "doc": "forge doc --build --out documentation",
    "gasreport": "FOUNDRY_PROFILE=default forge test -vvv --gas-report",
    "lint": "solhint --max-warnings 0 \"contracts/**/*.sol\" \"test/**/*.sol\" \"script/**/*.sol\" \"examples/**/*.sol\"",
    "lint:fix": "solhint --max-warnings 0 \"contracts/**/*.sol\" \"test/**/*.sol\" --fix",
    "test": "hardhat test solidity",
    "snapshot": "hardhat test solidity --snapshot",
    "snapshot:check": "hardhat test solidity --snapshot-check",
    "test:lite": "FOUNDRY_PROFILE=lite forge test -vvv",
    "test:zksync": "FOUNDRY_PROFILE=zksync forge test -vvv --zksync --force"
  }
}
