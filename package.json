{
  "name": "@1inch/cross-chain-swap",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:1inch/cross-chain-swap.git"
  },
  "license": "MIT",
  "dependencies": {
    "@1inch/limit-order-protocol-contract": "1inch/limit-order-protocol#b655e74665559450ebf3500c2149b805db8ee229",
    "@1inch/limit-order-settlement": "1inch/limit-order-settlement#78a5a68f4814361332e347071513b3d191a630e1",
    "@1inch/solidity-utils": "1inch/solidity-utils#94611cc4ddb6c7c55f9d20f3093074ecca5440ba",
    "@openzeppelin/contracts": "5.3.0"
  },
  "devDependencies": {
    "@ignored/imports-plugin": "0.0.1",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.0.11",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@types/node": "^26.1.0",
    "eslint": "8.56.0",
    "forge-std": "foundry-rs/forge-std#60acb7aaadcce2d68e52986a0a66fe79f07d138f",
    "hardhat": "3.17.0",
    "murky": "dmfxyz/murky#991e371eb1dfa9f86701869eb08ec4e98c3cc0b0",
    "patch-package": "^8.0.0",
    "rimraf": "5.0.5",
    "solc": "0.8.23",
    "solhint": "5.0.1",
    "typescript": "^6.0.3",
    "viem": "^2.54.6"
  },
  "resolutions": {
    "@1inch/limit-order-protocol-contract": "1inch/limit-order-protocol#b655e74665559450ebf3500c2149b805db8ee229",
    "@1inch/limit-order-settlement": "1inch/limit-order-settlement#78a5a68f4814361332e347071513b3d191a630e1",
    "@1inch/solidity-utils": "1inch/solidity-utils#94611cc4ddb6c7c55f9d20f3093074ecca5440ba",
    "@openzeppelin/contracts": "5.3.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "build": "hardhat compile",
    "build:zksync": "yarn deployers:foundry && FOUNDRY_PROFILE=zksync forge build --zksync -vvvvv --zk-compile=true --build-info --via-ir",
    "clean": "hardhat clean && rimraf coverage",
    "coverage": "hardhat test solidity --coverage",
    "coverage:zksync": "yarn deployers:foundry && mkdir -p coverage && FOUNDRY_PROFILE=zksync forge coverage --zksync --report lcov --ir-minimum --report-file coverage/lcov.info",
    "deploy": "hardhat run deploy/deploy-escrow-factory.ts",
    "deploy:erc20true": "hardhat run deploy/deploy-erc20-true.ts",
    "deploy:zksync": "yarn deployers:foundry && ./deploy/deploy-zksync.sh",
    "deployers:foundry": "mkdir -p dynamic-imports && cp -R foundry-deployers/. dynamic-imports/",
    "doc": "yarn deployers:foundry && forge doc --build --out documentation",
    "gasreport": "yarn deployers:foundry && FOUNDRY_PROFILE=default forge test -vvv --gas-report",
    "lint": "solhint --max-warnings 0 \"contracts/**/*.sol\" \"test/**/*.sol\" \"deploy/**/*.sol\" \"examples/**/*.sol\"",
    "lint:fix": "solhint --max-warnings 0 \"contracts/**/*.sol\" \"test/**/*.sol\" --fix",
    "snapshot": "hardhat test solidity --snapshot --grep-exclude testFuzz",
    "snapshot:check": "hardhat test solidity --snapshot-check --tolerance 5 --grep-exclude testFuzz",
    "test": "hardhat test solidity",
    "test:lite": "yarn deployers:foundry && FOUNDRY_PROFILE=lite forge test -vvv",
    "test:zksync": "yarn deployers:foundry && FOUNDRY_PROFILE=zksync forge test -vvv --zksync --force",
    "typecheck": "tsc --noEmit"
  }
}
